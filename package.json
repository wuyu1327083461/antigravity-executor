{
  "name": "antigravity-executor",
  "version": "0.6.0",
  "description": "Delegate coding tasks from DeepSeek Harness to the Google Antigravity desktop agent: an adaptive surgical/creative task mode that fixes 3D and front-end output with a Pass-1 visual gate, RPC-settled turns that return in seconds, an in-process serial queue, a destructive/escape split kill switch (including .git hooks and config), 5h + weekly quota guards with a 24h floor, human-like inter-turn pacing, dead-session self-heal with context recovery, 60s hanging-command circuit breaking, and a git snapshot inlined into every result.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/audit.js",
    "lib/artifacts.js",
    "lib/config-schema.js",
    "lib/discovery.js",
    "lib/pacing.js",
    "lib/platform.js",
    "lib/queue.js",
    "lib/quota.js",
    "lib/rpc.js",
    "lib/sessions.js",
    "lib/task-mode.js",
    "lib/transcript.js",
    "lib/turn.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "skills/*/SKILL.md"
  ],
  "scripts": {
    "test": "node --test lib/*.test.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "antigravity",
    "gemini",
    "agent",
    "mcp"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuyu1327083461/antigravity-executor.git"
  },
  "bugs": {
    "url": "https://github.com/wuyu1327083461/antigravity-executor/issues"
  },
  "homepage": "https://github.com/wuyu1327083461/antigravity-executor#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.4 <0.3.0"
  }
}
